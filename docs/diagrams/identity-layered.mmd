graph TB
    OP[Operator Wallet<br/>EOA / Multi-sig / Governance]

    subgraph Identity["Identity Layer — PDAs permanent"]
        CO[CompanyAccount PDA<br/>seeds: company + auth + nonce]
        AG1[AgentAccount PDA<br/>seeds: agent + company + 0]
        AG2[AgentAccount PDA<br/>seeds: agent + company + 1]
    end

    subgraph Treasury["Treasury Layer"]
        TR[TreasuryAccount PDA<br/>holds SOL + SPL]
        PO[PolicyAccount PDA<br/>Routine/Discretionary/Privileged]
    end

    subgraph Wallet["Wallet Layer — rotatable signers"]
        W1[Agent A signing key<br/>SLIP-0010 derived]
        W2[Agent B signing key<br/>MPC threshold]
    end

    subgraph Trace["Trace Anchor Layer"]
        TA1[TraceAnchorAccount<br/>task_id_1]
        TA2[TraceAnchorAccount<br/>task_id_2]
    end

    SBT[Token-2022 SBT<br/>NonTransferable - Phase 2+]

    OP -->|signs Privileged tx| CO
    OP -.->|transfer_authority| CO
    CO -->|treasury pointer| TR
    CO -->|policy pointer| PO
    CO --> AG1
    CO --> AG2
    AG1 -->|agent_address| W1
    AG2 -->|agent_address| W2
    W1 -->|signs commit_trace| TA1
    W2 -->|signs commit_trace| TA2
    SBT -.->|minted to PDA| AG1

    classDef pda fill:#1a3a5c,stroke:#5b9bd5,color:#dde8f5,stroke-width:2px
    classDef wallet fill:#5c4516,stroke:#d9a84a,color:#fff4dc,stroke-width:2px
    classDef trace fill:#3d1f4a,stroke:#b48fd9,color:#e8d4f5,stroke-width:2px
    classDef badge fill:#4a1f30,stroke:#d97da4,color:#f5d4e0,stroke-width:2px,stroke-dasharray: 5 5
    classDef op fill:#1a4a2e,stroke:#5fc784,color:#d4f0de,stroke-width:2px

    class CO,AG1,AG2,TR,PO pda
    class W1,W2 wallet
    class TA1,TA2 trace
    class SBT badge
    class OP op
