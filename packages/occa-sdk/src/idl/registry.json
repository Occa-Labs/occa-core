              {
                "kind": "account",
                "path": "company"
              },
              {
                "kind": "arg",
                "path": "deployment_index"
              }
            ]
          }
        },
        {
          "name": "payer",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {
