            "docs": [
              "Unix timestamp of last state mutation."
            ],
            "type": "i64"
          },
          {
            "name": "name",
            "docs": [
              "Display name (e.g. \"Aiden\"). Not unique — identities are",
              "disambiguated by `agent_pubkey`."
            ],
            "type": "string"
          },
          {
            "name": "metadata_uri",
            "docs": [
              "Off-chain metadata URI — persona, avatar, public bio."
            ],
            "type": "string"
          },
          {
            "name": "metadata_hash",
            "docs": [
