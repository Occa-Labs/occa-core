{
  "name": "occa-sdk",
  "version": "0.3.0",
  "description": "OCCA on-chain protocol SDK — PDA helpers, instruction builders, and types for the OCCA Registry + Treasury programs on Solana.",
  "license": "MIT",
  "author": "OCCA",
  "homepage": "https://github.com/Occa-Labs/occa-core/tree/main/packages/occa-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Occa-Labs/occa-core.git",
    "directory": "packages/occa-sdk"
  },
  "bugs": {
    "url": "https://github.com/Occa-Labs/occa-core/issues"
  },
  "keywords": [
    "solana",
    "anchor",
    "occa",
    "agent",
    "agent-identity",
    "ai-agents",
    "registry",
    "deployment",
    "web3"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./pda": {
      "types": "./dist/pda.d.ts",
      "import": "./dist/pda.js",
      "require": "./dist/pda.cjs"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    },
    "./instructions": {
      "types": "./dist/instructions.d.ts",
      "import": "./dist/instructions.js",
      "require": "./dist/instructions.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "sync-idl": "cp ../../../occa-programs/target/idl/registry.json src/idl/registry.json",
    "devnet-smoke": "tsx scripts/devnet-smoke.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
