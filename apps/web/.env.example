# Web (Next.js) environment — copy to apps/web/.env.local and fill in.
# Only NEXT_PUBLIC_* vars are read by the browser bundle; they are inlined
# at build time, so changing one needs a `next dev` / `next build` restart.
# The full flag list lives in src/lib/env-flags.ts.

# Base URL of the OCCA API server (apps/server). Defaults to
# http://localhost:3002 when unset.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Privy app id (public-safe) for wallet / social login. From console.privy.io.
NEXT_PUBLIC_PRIVY_APP_ID=

# Render the 3D office scene. OFF by default — without this the app runs
# image-only against a static background, which is what the public
# open-source mirror (Occa-Labs/occa-core) needs since it omits the
# commercially licensed 3D assets under public/models/. Set to "1" only
# where those assets are present (internal dev + prod) to render the full
# office and expose the 3D/image toggle.
# NEXT_PUBLIC_ENABLE_3D_OFFICE=1
