DATABASE_URL=postgresql://localhost:5432/occa
PORT=3002
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=change_me_32_byte_random_hex

# Web (Next.js) reads its own env from apps/web/.env.local — including
# NEXT_PUBLIC_API_URL and NEXT_PUBLIC_PRIVY_APP_ID. Don't add NEXT_PUBLIC_*
# here; server/worker (which load this file via tsx --env-file) don't
# need them and Next won't see them at this path.

# Optional. Path to an NDJSON log file the server tees pino output to.
# Defaults to apps/server/dev.log in development (so external tooling can
# tail without owning the terminal), disabled entirely in production.
# Set to "off" to disable the file sink in development too.
# OCCA_LOG_FILE=

# Privy — user authentication via embedded wallet / social login.
# Get from https://console.privy.io. App ID is public-safe (also exposed
# to web as NEXT_PUBLIC_PRIVY_APP_ID in apps/web/.env.local); secret is
# server-only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# GitHub personal access token (fine-grained, public repo read is enough).
# Used by:
#   - seed-builtin-skills on server boot (fetches SKILL.md + tree)
#   - POST /api/skills/import (user imports a GitHub skill URL)
#   - GET /api/skills/:id/files/* (runtime on-demand file streaming)
# Optional but strongly recommended: anon GitHub API = 60 req/hr and
# the seed alone makes 22 + 22 calls, so anon boots get rate-limited fast.
GITHUB_TOKEN=

# OpenClaw gateway VPS — SSH credentials for the dev "Reset gateway" button
# (POST /api/dev/reset-gateway). Server shells out via:
#   ssh -i $OCCA_GATEWAY_SSH_KEY $OCCA_GATEWAY_SSH_USER@$OCCA_GATEWAY_SSH_HOST
# The remote command lists agents, filters to `occa-*`, and deletes each via
# `openclaw agents delete <id> --force`. The `main` agent is CLI-protected so
# it survives even if the prefix filter ever drifts.
OCCA_GATEWAY_SSH_HOST=
OCCA_GATEWAY_SSH_USER=root
OCCA_GATEWAY_SSH_KEY=~/.ssh/id_rsa
# Path to the directory containing the `openclaw` binary on the gateway. The
# gateway typically runs under root's nvm install (default below). When the
# SSH user is non-root (e.g. `ubuntu` on AWS), the server wraps the remote
# command in `sudo -n bash -lc` and prepends this path to PATH so both
# `node` (shebang) and `openclaw` resolve. Override only if your install
# moves to a different node version or location.
OCCA_GATEWAY_OPENCLAW_PATH=/root/.nvm/versions/node/v24.15.0/bin

# Allowlist of Solana wallet addresses (base58, comma-separated, case-sensitive)
# permitted to call destructive dev endpoints:
#   POST /api/dev/reset                       (wipes DB)
#   POST /api/dev/reset-gateway               (SSH wipes OpenClaw VPS)
#   POST /api/dev/gc-orphan-openclaw-agents   (deprovisions orphans)
# Fail-closed: empty/unset → endpoints return 403 dev_wallet_not_configured.
# Auth flow: requireAuth (JWT) → requireDevWallet (allowlist match on
# req.user.walletAddress). A stolen JWT for a non-dev user still cannot
# trigger reset.
OCCA_DEV_WALLETS=
